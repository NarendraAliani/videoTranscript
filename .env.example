APP_NAME=VideoTranscript
APP_ENV=production
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Kolkata
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database
DB_USER=your_user
DB_PASS=change_me

# Upload transcription provider: groq (recommended), openai, or custom
UPLOAD_ASR_PROVIDER=groq
GROQ_API_KEY=
GROQ_ASR_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_ASR_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_ASR_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_ASR_MODEL=gpt-transcribe
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_MAX_FILE_MB=25

# URL transcription adapter (separate from uploaded-file ASR)
URL_TRANSCRIPT_PROVIDER=compatible_api
TRANSCRIPT_API_URL=
TRANSCRIPT_API_TOKEN=
URL_TRANSCRIPT_MODEL=platform-default

# AI generation: Groq key can be shared with upload ASR; override with LLM_* if desired
AI_PROVIDER=groq
GROQ_CHAT_MODEL=openai/gpt-oss-20b
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

UPLOAD_MAX_MB=25
UPLOAD_DIR=storage/uploads
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
